{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/announcements\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/contacts\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/data\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/docs\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/logbooks\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/personnel\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/api\\/reports\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}